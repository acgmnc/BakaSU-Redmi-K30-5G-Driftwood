--- a/drivers/input/touchscreen/xiaomi/xiaomi_touch.c
+++ b/drivers/input/touchscreen/xiaomi/xiaomi_touch.c
@@ -274,8 +274,20 @@
 {
 	struct xiaomi_touch_pdata *pdata = dev_get_drvdata(dev);
 	struct xiaomi_touch *touch_dev = pdata->device;
-
-	wait_event_interruptible(touch_dev->wait_queue, pdata->psensor_changed);
+	long ret;
+
+	/*
+	 * Bounded wait, same hazard as palm_sensor_show(): when the touch
+	 * controller stops delivering events (i2c_geni: i2c error :-107) a
+	 * blocking read never returns and holds kernfs' per-open mutex, so
+	 * the sensors HAL's write on the same fd blocks in D state and takes
+	 * SensorService / system_server down with it.  Time out instead.
+	 */
+	ret = wait_event_interruptible_timeout(touch_dev->wait_queue,
+					       pdata->psensor_changed,
+					       msecs_to_jiffies(500));
+	if (ret == -ERESTARTSYS)
+		return -ERESTARTSYS;
 	pdata->psensor_changed = false;
 
 	return snprintf(buf, PAGE_SIZE, "%d\n", pdata->psensor_value);
